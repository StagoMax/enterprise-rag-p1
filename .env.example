RAG_DEV_MODE=true
RAG_JWT_SECRET=replace-this-local-secret
RAG_EMBEDDING_BACKEND=hashing
RAG_NEMOTRON_MODEL_ID=models/nemotron-3-embed-1b
RAG_NEMOTRON_DIMENSIONS=1024
RAG_NEMOTRON_DEVICE=cuda
RAG_BGE_MODEL_ID=models/bge-m3
RAG_BGE_DEVICE=cuda
# none | cross_encoder | llm。cross_encoder 在 P1 实测是负增益（Top-1 0.875 -> 0.825）；
# llm 走下面的生成后端，在更大的候选池上重排。
RAG_RERANKER_BACKEND=none
RAG_RERANK_CANDIDATES=20
RAG_DENSE_WEIGHT=0.5

# 向量存储。memory 是进程内实现，仅供离线测试；
# milvus 下 URI 为本地文件即嵌入式 Milvus Lite，换成 http(s)/grpc 地址即独立部署，代码不变。
RAG_VECTOR_BACKEND=memory
RAG_MILVUS_URI=data/milvus/enterprise-rag.db
RAG_MILVUS_COLLECTION=enterprise_chunks
RAG_MILVUS_SEARCH_MULTIPLIER=4

# 生成后端（OpenAI 兼容）。也接受 .env 里已有的 OPENTOPIA_OPENAI_BASE_URL /
# OPENTOPIA_MODEL / OPENTOPIA_MODEL_KEY 三个名字。
# 注意：这里刻意不认通用的 OPENAI_API_KEY——环境变量优先级高于 .env，
# 机器上一个无关的 OPENAI_API_KEY 会静默顶掉本项目凭据（表现为 401）。
# extractive 则完全不调用模型，回退到确定性证据摘录。
RAG_LLM_BACKEND=openai_compatible
RAG_LLM_BASE_URL=
RAG_LLM_MODEL=
RAG_LLM_API_KEY=
RAG_LLM_TIMEOUT_SECONDS=90
RAG_LLM_MAX_TOKENS=1200
RAG_GRAPH_ENABLED=true
RAG_GRAPH_SEED_COUNT=2
RAG_GRAPH_MAX_HOPS=2
RAG_GRAPH_EXPANSION_LIMIT=12
RAG_GRAPH_SCORE_DECAY=0.82
RAG_INDEX_VERSION=p2-techqa-1000-v1
RAG_AUDIT_PATH=data/audit.jsonl
RAG_FEEDBACK_PATH=data/feedback.jsonl
RAG_DEMO_DB_PATH=data/demo.sqlite
RAG_CORPUS_PATH=data/processed/techqa_p2/documents.jsonl
RAG_RELATIONS_PATH=data/processed/techqa_p2/relations.jsonl
RAG_GRAPH_STATE_PATH=data/graph-state.json
RAG_GOLD_PATH=data/processed/techqa_p2/golden_questions.jsonl
RAG_EVALUATION_REPORT_PATH=reports/p2-baseline-current.json
